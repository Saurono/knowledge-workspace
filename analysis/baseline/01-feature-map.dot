digraph G {
graph [rankdir=LR, bgcolor="#f7f9fc", pad="0.4", nodesep="0.18", ranksep="0.5", label="LLM Wiki v0.6.13 · 原生功能框图", labelloc=t, fontsize=24, fontname="Noto Sans CJK SC"];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12, color="#ccd7e5", fillcolor="white", margin="0.18,0.12"];
edge [color="#9bacc2"];
ROOT [label="LLM Wiki\n本地知识库", fillcolor="#173552", fontcolor=white];
P [label="项目与知识结构",fillcolor="#e4edf8"];
P_d [label="新建项目与场景模板\n打开、切换与最近项目\n知识目标与结构规则\nMarkdown 知识模型\n知识树与文件树\n项目迁移与索引重建",shape=box,fontsize=11];
ROOT -> P -> P_d;
S [label="资料采集与同步",fillcolor="#e4edf8"];
S_d [label="多文件导入\n递归文件夹导入\n批量 URL 导入\nChrome 网页剪藏\n剪藏接收服务\n项目来源目录监听\n定时外部目录导入\n同步规则与并发设置\n来源管理与级联删除",shape=box,fontsize=11];
ROOT -> S -> S_d;
D [label="解析与多模态",fillcolor="#e4edf8"];
D_d [label="文本与结构化文本\nOffice 文档转 Markdown\nPDF 文字和图片提取\nMinerU 可选解析\n电子书提取\n图片描述与图文入库\n解析预处理和缓存\n音视频与未知二进制边界",shape=box,fontsize=11];
ROOT -> D -> D_d;
I [label="知识编译与任务队列",fillcolor="#e4edf8"];
I_d [label="两阶段入库\n增量跳过\n长资料分块与上下文控制\n生成与更新知识资产\n已有页面内容合并\n生成审阅项\n持久队列与恢复\n并发执行与提交协调\n任务进度与限额处理\n完成后的衍生维护",shape=box,fontsize=11];
ROOT -> I -> I_d;
R [label="搜索与证据检索",fillcolor="#e4edf8"];
R_d [label="关键词搜索\n可选向量语义检索\n混合排序与图扩展\n搜索结果与图片证据\n原文证据模式\n外部本机全文检索",shape=box,fontsize=11];
ROOT -> R -> R_d;
C [label="聊天与 Agent",fillcolor="#e4edf8"];
C_d [label="多会话管理\n四种 Agent 模式\n三种检索模式\nRust 工具调用运行时\n流式过程与取消\n图像与上下文输入\n引用与证据预览\n对话写入 Wiki\nAgent 文件生成与变更展示\nWiki 写入与 Shell 执行\n结构化用户交互",shape=box,fontsize=11];
ROOT -> C -> C_d;
E [label="阅读、编辑与版本",fillcolor="#e4edf8"];
E_d [label="阅读与富文本编辑\n数学与图表渲染\n文档与媒体预览\n元数据与链接导航\n选中文本 AI 问答\n选区 AI 修改与差异确认\n文件版本与恢复\nWiki 页面删除",shape=box,fontsize=11];
ROOT -> E -> E_d;
G [label="知识图谱与洞察",fillcolor="#e4edf8"];
G_d [label="图谱构建与交互\n筛选与可见性控制\n四信号关联评分\n社区发现\n意外关联与知识缺口\n洞察触发研究",shape=box,fontsize=11];
ROOT -> G -> G_d;
Q [label="审阅与知识质量",fillcolor="#e4edf8"];
Q_d [label="异步审阅队列\n审阅动作与批处理\n结构检查\n语义检查\n修复与批量处理\n实体去重检测\n去重合并队列\n审阅自动复核",shape=box,fontsize=11];
ROOT -> Q -> Q_d;
W [label="深度研究",fillcolor="#e4edf8"];
W_d [label="多入口选题\n网页与本地联合采证\n搜索服务适配\n报告综合与引用校验\n研究落盘与再入库\n研究任务面板",shape=box,fontsize=11];
ROOT -> W -> W_d;
X [label="Skill 与外部接口",fillcolor="#e4edf8"];
X_d [label="本地 Skill 扫描\nSkill 启停与会话选择\nJSON HTTP API\nAgent API 与 SSE\nAPI 访问配置\nMCP 适配服务\n外部 Agent skill 文档",shape=box,fontsize=11];
ROOT -> X -> X_d;
A [label="模型、设置与桌面运行",fillcolor="#e4edf8"];
A_d [label="多供应商与 CLI\n任务和项目模型路由\n推理与上下文配置\n独立处理服务设置\n网络代理\n语言与外观\n桌面生命周期\n版本与分发",shape=box,fontsize=11];
ROOT -> A -> A_d;
}
