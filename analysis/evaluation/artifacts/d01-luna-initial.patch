+  const complete = knowledgeReady && (policy.feedback === "disabled" || feedbackDelivered)
+  const statuses = INGESTION_STAGES.map(stage => stages[stage].status)
+  const status = statuses.includes("running") ? "processing" : !contentReady ? (stages.receive.status === "succeeded" && stages.parse.status === "pending" ? "received" : statuses.some(s => ["failed", "blocked"].includes(s)) ? "failed" : statuses.includes("cancelled") ? "cancelled" : "processing") : complete ? "ready" : statuses.some(s => ["failed", "blocked"].includes(s)) ? "partial" : statuses.includes("cancelled") ? "cancelled" : "partial"
+  return { status, contentReady, knowledgeReady, feedbackDelivered, complete } as const
+}
