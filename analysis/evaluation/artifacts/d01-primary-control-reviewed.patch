+  const url = `http://127.0.0.1:${(http.server.address() as AddressInfo).port}/api/v1`
+  const request = (path: string, options: RequestInit = {}) => fetch(url + path, { ...options, headers: { Cookie: cookie, "X-KW-CSRF": "1", "Content-Type": "application/json", ...options.headers } })
