+import { describe, it, expect } from "vitest"
+import { createReceivedCheckpoint, beginStage, finishStage, retryStage, recoverInterrupted, summarizeIngestion, validateCheckpoint } from "./checkpoint"
+import type { IngestionCheckpointV1, IngestionStage } from "./checkpoint"
+const now = "2026-01-01T00:00:00.000Z"
+const initial = (indexPolicy: "required" | "disabled" = "required", feedbackPolicy: "required" | "disabled" = "disabled") => createReceivedCheckpoint({ projectId: "project", documentId: "doc", receivedAt: now, artifactRef: "blob:doc", indexPolicy, feedbackPolicy })
+function success(c: IngestionCheckpointV1, stage: IngestionStage) { const running = beginStage(c, stage, { now, attemptId: stage }); return finishStage(running, stage, { now, attemptId: stage, attempt: running.stages[stage].attempt, outcome: "succeeded", evidence: [`artifact:${stage}`] }) }
+const compiled = (feedback: "required" | "disabled" = "disabled") => success(success(initial("required", feedback), "parse"), "compile")
+describe("checkpoint protocol", () => {
+  it("starts received, completes legal stages with evidence and keeps input immutable", () => {
+    const c = initial(), original = structuredClone(c)
+    expect(summarizeIngestion(c)).toEqual({ status: "received", contentReady: false, knowledgeReady: false, feedbackDelivered: false, complete: false })
+    const ready = success(success(success(c, "parse"), "compile"), "index")
+    expect(summarizeIngestion(ready)).toMatchObject({ status: "ready", complete: true, feedbackDelivered: false })
+    expect(c).toEqual(original)
+    ready.stages.receive.evidence.push("another")
+    expect(c).toEqual(original)
+  })
+  it("requires real required feedback and supports explicitly disabled optional stages", () => {
+    const c = success(compiled("required"), "index")
+    expect(summarizeIngestion(c)).toMatchObject({ status: "partial", knowledgeReady: true, complete: false })
+    expect(summarizeIngestion(success(c, "feedback"))).toMatchObject({ status: "ready", feedbackDelivered: true, complete: true })
+    const disabled = success(success(initial("disabled"), "parse"), "compile")
+    expect(summarizeIngestion(disabled).complete).toBe(true)
+    expect(() => retryStage(disabled, "index", now)).toThrow()
+  })
+  it.each(["index", "feedback"] as const)("preserves upstream results when %s fails and retries", stage => {
+    const c = stage === "index" ? compiled() : success(compiled("required"), "index")
+    const running = beginStage(c, stage, { now, attemptId: "first" })
+    const failed = finishStage(running, stage, { now, attempt: 1, attemptId: "first", outcome: "failed", error: { code: "unavailable", message: "Retry the configured provider" } })
+    expect(summarizeIngestion(failed)).toMatchObject({ status: "partial", contentReady: true, knowledgeReady: stage === "feedback", complete: false })
+    const retried = retryStage(failed, stage, now)
+    expect(retried.stages.compile).toEqual(c.stages.compile)
+    expect(summarizeIngestion(success(retried, stage)).complete).toBe(true)
+  })
+  it.each(["cancelled", "blocked"] as const)("rejects late results after %s and after retry", outcome => {
+    const running = beginStage(initial(), "parse", { now, attemptId: "old" })
+    const ended = finishStage(running, "parse", { now, attempt: 1, attemptId: "old", outcome, error: { code: outcome, message: "Retry explicitly" } })
+    const result = { now, attempt: 1, attemptId: "old", outcome: "succeeded" as const, evidence: ["ref"] }
+    expect(() => finishStage(ended, "parse", result)).toThrow()
+    const restarted = beginStage(retryStage(ended, "parse", now), "parse", { now, attemptId: "new" })
+    expect(restarted.stages.parse.attempt).toBe(2)
+    expect(() => finishStage(restarted, "parse", result)).toThrow()
+  })
+  it("recovery blocks running, invalidates old results and is otherwise unchanged", () => {
+    const c = initial(); expect(recoverInterrupted(c, now)).toBe(c)
+    const running = beginStage(c, "parse", { now, attemptId: "first" }), original = structuredClone(running)
+    const recovered = recoverInterrupted(running, now)
+    expect(recovered.stages.parse.error?.code).toBe("interrupted")
+    expect(running).toEqual(original)
+    expect(() => finishStage(recovered, "parse", { now, attempt: 1, attemptId: "first", outcome: "succeeded", evidence: ["x"] })).toThrow()
+    expect(beginStage(retryStage(recovered, "parse", now), "parse", { now, attemptId: "next" }).stages.parse.attempt).toBe(2)
+  })
+  it("rejects empty evidence, errors, invalid times, malformed data and skipped dependencies", () => {
+    const running = beginStage(success(initial(), "parse"), "compile", { now, attemptId: "compile" })
+    expect(() => finishStage(running, "compile", { now, attempt: 1, attemptId: "compile", outcome: "succeeded", evidence: [] })).toThrow()
+    expect(() => finishStage(running, "compile", { now, attempt: 1, attemptId: "compile", outcome: "failed" })).toThrow()
+    expect(() => beginStage(initial(), "compile", { now, attemptId: "x" })).toThrow()
+    expect(() => beginStage(initial(), "parse", { now: "2025-12-31T23:59:59Z", attemptId: "x" })).toThrow()
+    expect(() => recoverInterrupted(initial(), "2026-02-30T00:00:00Z")).toThrow()
+    for (const mutate of [(c: IngestionCheckpointV1) => { c.schemaVersion = 2 as 1 }, (c: IngestionCheckpointV1) => { c.stages.parse.status = "skipped" }, (c: IngestionCheckpointV1) => { c.stages.receive.evidence = [] }, (c: IngestionCheckpointV1) => { c.documentId = "../doc" }]) { const c = initial(); mutate(c); expect(() => validateCheckpoint(c)).toThrow() }
+  })
+})
diff --git a/src/modules/ingestion/domain/checkpoint.ts b/src/modules/ingestion/domain/checkpoint.ts
new file mode 100644
index 0000000..8b273b3
--- /dev/null
+++ b/src/modules/ingestion/domain/checkpoint.ts
@@ -0,0 +1,102 @@
+/** Evidence references only; this protocol never executes ingestion work. */
+export const ingestionStages = ["receive", "parse", "compile", "index", "feedback"] as const
+export type IngestionStage = typeof ingestionStages[number]
+export type StageStatus = "pending" | "running" | "succeeded" | "failed" | "blocked" | "cancelled" | "skipped"
+export interface StageRecord {
+  status: StageStatus; attempt: number; attemptId: string | null; startedAt: string | null; finishedAt: string | null
+  evidence: string[]; error: { code: string; message: string } | null
+}
+export interface IngestionCheckpointV1 {
+  schemaVersion: 1; projectId: string; documentId: string; createdAt: string; updatedAt: string
+  policy: { index: "required" | "disabled"; feedback: "required" | "disabled" }
+  stages: Record<IngestionStage, StageRecord>
+}
+const fail = (message: string): never => { throw new Error(`Invalid ingestion checkpoint: ${message}`) }
+const text = (v: unknown): v is string => typeof v === "string" && v.trim().length > 0
+const id = (v: unknown): v is string => typeof v === "string" && /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(v)
+const iso = (v: unknown): v is string => typeof v === "string" && /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?(?:Z|[+-]\d\d:\d\d)$/.test(v) && Number.isFinite(Date.parse(v)) && validCalendar(v)
+function validCalendar(v: string) {
+  const y = Number(v.slice(0, 4)), m = Number(v.slice(5, 7)), d = Number(v.slice(8, 10))
+  return m >= 1 && m <= 12 && d >= 1 && d <= new Date(Date.UTC(y, m, 0)).getUTCDate() && Number(v.slice(11, 13)) < 24 && Number(v.slice(14, 16)) < 60 && Number(v.slice(17, 19)) < 60
+}
+const done = (s: StageRecord) => s.status === "succeeded" || s.status === "skipped"
+const object = (v: unknown): v is Record<string, unknown> => !!v && typeof v === "object" && !Array.isArray(v)
+export function validateCheckpoint(value: unknown): IngestionCheckpointV1 {
+  if (!object(value) || value.schemaVersion !== 1 || !id(value.projectId) || !id(value.documentId)) fail("version or identity")
+  const c = value as unknown as IngestionCheckpointV1
+  if (!iso(c.createdAt) || !iso(c.updatedAt) || Date.parse(c.updatedAt) < Date.parse(c.createdAt)) fail("checkpoint times")
+  if (!object(c.policy) || !["required", "disabled"].includes(c.policy.index) || !["required", "disabled"].includes(c.policy.feedback)) fail("policy")
+  if (!object(c.stages) || Object.keys(c.stages).length !== 5 || ingestionStages.some(k => !Object.prototype.hasOwnProperty.call(c.stages, k))) fail("stage set")
+  for (const [i, stage] of ingestionStages.entries()) {
+    const s = c.stages[stage]
+    if (!object(s) || !["pending", "running", "succeeded", "failed", "blocked", "cancelled", "skipped"].includes(s.status) || !Number.isSafeInteger(s.attempt) || s.attempt < 0 || !Array.isArray(s.evidence) || !s.evidence.every(text)) fail(`${stage} record`)
+    const disabled = (stage === "index" || stage === "feedback") && c.policy[stage] === "disabled"
+    if (disabled !== (s.status === "skipped")) fail(`${stage} disabled policy`)
+    if (s.status === "pending" || s.status === "skipped") {
+      if (s.attemptId !== null || s.startedAt !== null || s.finishedAt !== null || s.evidence.length || s.error !== null || (s.status === "skipped" && s.attempt !== 0)) fail(`${stage} idle state`)
+    } else {
+      if (s.attempt < 1 || !text(s.attemptId) || !iso(s.startedAt) || Date.parse(s.startedAt as string) < Date.parse(c.createdAt) || Date.parse(s.startedAt as string) > Date.parse(c.updatedAt)) fail(`${stage} attempt`)
+      if (s.status === "running") {
+        if (s.finishedAt !== null || s.evidence.length || s.error !== null) fail(`${stage} running state`)
+      } else {
+        if (!iso(s.finishedAt) || Date.parse(s.finishedAt) < Date.parse(s.startedAt as string) || Date.parse(s.finishedAt) > Date.parse(c.updatedAt)) fail(`${stage} finish time`)
+        if (s.status === "succeeded") { if (!s.evidence.length || s.error !== null) fail(`${stage} success evidence`) }
+        else if (!object(s.error) || !text(s.error.code) || !text(s.error.message)) fail(`${stage} actionable error`)
+      }
+      for (const upstream of ingestionStages.slice(0, i)) {
+        const u = c.stages[upstream]
+        if (!done(u) || (u.finishedAt && Date.parse(s.startedAt as string) < Date.parse(u.finishedAt))) fail(`${stage} dependencies`)
+      }
+    }
+    if (s.status === "pending" && s.attempt > 0 && !ingestionStages.slice(0, i).every(k => done(c.stages[k]))) fail(`${stage} retry dependencies`)
+  }
+  if (c.stages.receive.status !== "succeeded" || c.stages.receive.attempt !== 1 || c.stages.receive.startedAt !== c.createdAt || c.stages.receive.finishedAt !== c.createdAt) fail("receipt")
+  return c
+}
+function checked(c: IngestionCheckpointV1, now: string) {
+  validateCheckpoint(c)
+  if (!iso(now) || Date.parse(now) < Date.parse(c.updatedAt)) fail("operation time")
+  return structuredClone(c)
+}
+export function createReceivedCheckpoint(input: { projectId: string; documentId: string; receivedAt: string; artifactRef: string; indexPolicy?: "required" | "disabled"; feedbackPolicy?: "required" | "disabled" }): IngestionCheckpointV1 {
+  if (!text(input.artifactRef)) fail("artifact reference")
+  const policy = { index: input.indexPolicy ?? "required", feedback: input.feedbackPolicy ?? "disabled" }
+  const stages = Object.fromEntries(ingestionStages.map(stage => [stage, { status: ((stage === "index" || stage === "feedback") && policy[stage] === "disabled") ? "skipped" : "pending", attempt: 0, attemptId: null, startedAt: null, finishedAt: null, evidence: [], error: null }])) as unknown as IngestionCheckpointV1["stages"]
+  stages.receive = { status: "succeeded", attempt: 1, attemptId: "receive", startedAt: input.receivedAt, finishedAt: input.receivedAt, evidence: [input.artifactRef], error: null }
+  return validateCheckpoint({ schemaVersion: 1, projectId: input.projectId, documentId: input.documentId, createdAt: input.receivedAt, updatedAt: input.receivedAt, policy, stages })
+}
+export function beginStage(c: IngestionCheckpointV1, stage: IngestionStage, input: { attemptId: string; now: string }) {
+  const next = checked(c, input.now), s = next.stages[stage]
+  if (!s || s.status !== "pending" || !text(input.attemptId) || !ingestionStages.slice(0, ingestionStages.indexOf(stage)).every(k => done(next.stages[k]))) fail("stage cannot begin")
+  Object.assign(s, { status: "running", attempt: s.attempt + 1, attemptId: input.attemptId, startedAt: input.now })
+  next.updatedAt = input.now; return validateCheckpoint(next)
+}
+export interface FinishStageInput { attempt: number; attemptId: string; now: string; outcome: "succeeded" | "failed" | "blocked" | "cancelled"; evidence?: string[]; error?: { code: string; message: string } }
+export function finishStage(c: IngestionCheckpointV1, stage: IngestionStage, input: FinishStageInput) {
+  const next = checked(c, input.now), s = next.stages[stage]
+  if (!s || s.status !== "running" || s.attempt !== input.attempt || s.attemptId !== input.attemptId || !["succeeded", "failed", "blocked", "cancelled"].includes(input.outcome)) fail("stale or invalid result")
+  Object.assign(s, { status: input.outcome, finishedAt: input.now, evidence: input.evidence ? [...input.evidence] : [], error: input.error ? { ...input.error } : null })
+  next.updatedAt = input.now; return validateCheckpoint(next)
+}
+export function retryStage(c: IngestionCheckpointV1, stage: IngestionStage, now: string) {
+  const next = checked(c, now), s = next.stages[stage]
+  if (!s || !["failed", "blocked", "cancelled"].includes(s.status)) fail("stage cannot retry")
+  Object.assign(s, { status: "pending", attemptId: null, startedAt: null, finishedAt: null, evidence: [], error: null })
+  next.updatedAt = now; return validateCheckpoint(next)
+}
+export function recoverInterrupted(c: IngestionCheckpointV1, now: string) {
+  const next = checked(c, now)
+  if (!ingestionStages.some(k => next.stages[k].status === "running")) return c
+  for (const stage of ingestionStages) if (next.stages[stage].status === "running") Object.assign(next.stages[stage], { status: "blocked", finishedAt: now, error: { code: "interrupted", message: "Worker interrupted; retry with a new attempt before resuming." } })
+  next.updatedAt = now; return validateCheckpoint(next)
+}
+export function summarizeIngestion(value: IngestionCheckpointV1) {
+  const c = validateCheckpoint(value), s = c.stages
+  const contentReady = s.compile.status === "succeeded"
+  const knowledgeReady = contentReady && done(s.index)
+  const feedbackDelivered = s.feedback.status === "succeeded"
+  const complete = knowledgeReady && (c.policy.feedback === "disabled" || feedbackDelivered)
+  const statuses = ingestionStages.map(k => s[k].status)
+  const status: "received" | "processing" | "waiting" | "failed" | "cancelled" | "partial" | "ready" = complete ? "ready" : statuses.includes("running") ? "processing" : contentReady ? "partial" : statuses.includes("failed") ? "failed" : statuses.includes("cancelled") ? "cancelled" : statuses.includes("blocked") ? "waiting" : s.parse.attempt === 0 && s.compile.attempt === 0 ? "received" : "waiting"
+  return { status, contentReady, knowledgeReady, feedbackDelivered, complete }
+}
