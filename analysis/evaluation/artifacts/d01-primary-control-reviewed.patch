+import { expect, it, vi } from "vitest"
+import { createReceivedCheckpoint } from "../domain"
+import { createIngestionLifecycleService } from "./lifecycle"
+const now = "2026-01-01T00:00:00Z"
+const checkpoint = () => createReceivedCheckpoint({ projectId: "p", documentId: "d", receivedAt: now, artifactRef: "blob:d" })
+it("checks ownership and expected revision before save, propagates failed persistence, avoids no-op versions", async () => {
+  const stored = { revision: 1, checkpoint: checkpoint() }, original = structuredClone(stored), failure = new Error("CAS failed")
+  const save = vi.fn(async () => { throw failure }), read = vi.fn(async () => stored)
+  const service = createIngestionLifecycleService({ read, save })
+  await expect(service.begin("other", "d", 1, "parse", { now, attemptId: "a" })).rejects.toThrow("ownership")
+  await expect(service.begin("p", "d", 2, "parse", { now, attemptId: "a" })).rejects.toThrow("revision")
+  expect(save).not.toHaveBeenCalled()
+  await expect(service.begin("p", "d", 1, "parse", { now, attemptId: "a" })).rejects.toBe(failure)
+  expect(stored).toEqual(original)
+  expect(await service.recover("p", "d", 1, now)).toBe(stored)
+  expect(save).toHaveBeenCalledOnce()
+})
+it("exposes structured lifecycle failures and rejects invalid revisions before persistence", async () => {
+  const save = vi.fn(), stored = { revision: 1, checkpoint: checkpoint() }
+  const read = vi.fn(async () => stored)
+  const service = createIngestionLifecycleService({ read, save })
+  for (const revision of [0, -1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    await expect(service.begin("p", "d", revision, "parse", { now, attemptId: "a" })).rejects.toMatchObject({ name: "IngestionLifecycleError", code: "invalid_argument" })
+  }
+  expect(read).not.toHaveBeenCalled()
+  await expect(service.begin("p", "d", 2, "parse", { now, attemptId: "a" })).rejects.toMatchObject({ code: "conflict" })
+  await expect(service.begin("p", "d", 1, "compile", { now, attemptId: "a" })).rejects.toMatchObject({ code: "invalid_argument" })
+  await expect(createIngestionLifecycleService({ read: async () => null, save }).retry("p", "d", 1, "parse", now)).rejects.toMatchObject({ code: "not_found" })
+  for (const revision of [0, -1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    await expect(createIngestionLifecycleService({ read: async () => ({ ...stored, revision }), save }).read("p", "d")).rejects.toMatchObject({ code: "invalid_argument" })
+  }
+  await expect(service.read("../p", "d")).rejects.toMatchObject({ code: "invalid_argument" })
+  expect(save).not.toHaveBeenCalled()
+})
diff --git a/src/modules/ingestion/application/lifecycle.ts b/src/modules/ingestion/application/lifecycle.ts
new file mode 100644
index 0000000..6f2c56e
--- /dev/null
+++ b/src/modules/ingestion/application/lifecycle.ts
@@ -0,0 +1,49 @@
+import { beginStage, finishStage, retryStage, recoverInterrupted, validateCheckpoint } from "../domain"
+import type { IngestionCheckpointV1, IngestionStage, FinishStageInput } from "../domain"
+export type IngestionLifecycleErrorCode = "invalid_argument" | "not_found" | "conflict"
+export class IngestionLifecycleError extends Error {
+  constructor(public readonly code: IngestionLifecycleErrorCode, message: string) { super(message); this.name = "IngestionLifecycleError" }
+}
+function requireRevision(revision: number) {
+  if (!Number.isSafeInteger(revision) || revision < 1) throw new IngestionLifecycleError("invalid_argument", "Checkpoint revision must be a positive safe integer")
+}
+function requireIdentity(projectId: string, documentId: string) {
+  if (![projectId, documentId].every(id => typeof id === "string" && /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(id))) throw new IngestionLifecycleError("invalid_argument", "Invalid checkpoint identity")
+}
+function validateRule<T>(rule: () => T): T {
+  try { return rule() }
+  catch (error) { throw new IngestionLifecycleError("invalid_argument", error instanceof Error ? error.message : "Invalid checkpoint operation") }
+}
+export interface CheckpointSnapshot { revision: number; checkpoint: IngestionCheckpointV1 }
+export interface IngestionCheckpointRepository {
+  read(projectId: string, documentId: string): Promise<CheckpointSnapshot | null>
+  save(projectId: string, documentId: string, expectedRevision: number, checkpoint: IngestionCheckpointV1): Promise<CheckpointSnapshot>
+}
+export function createIngestionLifecycleService(repository: IngestionCheckpointRepository) {
+  const read = async (projectId: string, documentId: string) => {
+    requireIdentity(projectId, documentId)
+    const result = await repository.read(projectId, documentId)
+    if (result) {
+      requireRevision(result.revision)
+      validateRule(() => validateCheckpoint(result.checkpoint))
+      if (result.checkpoint.projectId !== projectId || result.checkpoint.documentId !== documentId) throw new IngestionLifecycleError("invalid_argument", "Checkpoint ownership mismatch")
+    }
+    return result
+  }
+  const mutate = async (projectId: string, documentId: string, expectedRevision: number, rule: (c: IngestionCheckpointV1) => IngestionCheckpointV1) => {
+    requireRevision(expectedRevision)
+    const current = await read(projectId, documentId)
+    if (!current) throw new IngestionLifecycleError("not_found", "Checkpoint not found")
+    if (current.revision !== expectedRevision) throw new IngestionLifecycleError("conflict", "Checkpoint revision conflict")
+    const next = validateRule(() => rule(current.checkpoint))
+    if (next === current.checkpoint) return current
+    return repository.save(projectId, documentId, expectedRevision, next)
+  }
+  return {
+    read,
+    begin: (p: string, d: string, revision: number, stage: IngestionStage, input: { attemptId: string; now: string }) => mutate(p, d, revision, c => beginStage(c, stage, input)),
+    finish: (p: string, d: string, revision: number, stage: IngestionStage, input: FinishStageInput) => mutate(p, d, revision, c => finishStage(c, stage, input)),
+    retry: (p: string, d: string, revision: number, stage: IngestionStage, now: string) => mutate(p, d, revision, c => retryStage(c, stage, now)),
+    recover: (p: string, d: string, revision: number, now: string) => mutate(p, d, revision, c => recoverInterrupted(c, now)),
+  }
+}
