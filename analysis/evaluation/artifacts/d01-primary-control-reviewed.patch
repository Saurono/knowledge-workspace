index 0000000..99faae0
--- /dev/null
+++ b/server/ingestion-checkpoints.ts
@@ -0,0 +1,49 @@
+import { createReceivedCheckpoint, validateCheckpoint } from "@/modules/ingestion/domain"
+import type { IngestionCheckpointV1 } from "@/modules/ingestion/domain"
+import type { IngestionCheckpointRepository } from "@/modules/ingestion/application"
+import type { SharedRepository } from "@/modules/service-api/application"
+import { ServiceError, requireId } from "@/modules/service-api/domain"
+/** Uses the supplied port throughout, including its authorization and CAS checks. */
+export function createDocumentCheckpointRepository(shared: SharedRepository): IngestionCheckpointRepository {
+  const record = async (p: string, d: string) => {
+    requireId(p); requireId(d)
+    const value = await shared.get(p, "document", d)
+    if (value && (value.projectId !== p || value.key !== d || value.kind !== "document")) throw new ServiceError("internal", "Document ownership mismatch")
+    return value
+  }
+  const checkpoint = (data: unknown, p: string, d: string): IngestionCheckpointV1 => {
+    if (!data || typeof data !== "object" || Array.isArray(data)) throw new ServiceError("internal", "Invalid document metadata")
+    const value = data as Record<string, unknown>
+    let c: IngestionCheckpointV1
+    if (Object.prototype.hasOwnProperty.call(value, "ingestionCheckpoint")) c = validateCheckpoint(value.ingestionCheckpoint)
+    else {
+      // These fields were written only after binary storage completed in the old receiver.
+      const validName = typeof value.name === "string" && value.name === value.name.normalize("NFC").trim()
+        && value.name.length > 0 && value.name.length <= 255 && !/[/\\\x00-\x1f\x7f]/.test(value.name) && ![".", ".."].includes(value.name)
+      const validMediaType = typeof value.mediaType === "string" && /^[A-Za-z0-9!#$%&'*+.^_`|~-]+\/[A-Za-z0-9!#$%&'*+.^_`|~-]+$/.test(value.mediaType)
+      const validDigest = typeof value.sha256 === "string" && /^[a-f0-9]{64}$/i.test(value.sha256)
+      if (value.id !== d || value.sourceId !== d || value.status !== "received" || value.sourceIngestedAt !== null
+        || !validName || !validMediaType || !validDigest || !Number.isSafeInteger(value.size) || Number(value.size) <= 0
+        || typeof value.receivedAt !== "string") throw new ServiceError("internal", "Reliable receipt metadata required for legacy document")
+      c = createReceivedCheckpoint({ projectId: p, documentId: d, receivedAt: value.receivedAt, artifactRef: `document:${p}/${d}/source` })
+    }
+    if (c.projectId !== p || c.documentId !== d) throw new ServiceError("internal", "Checkpoint ownership mismatch")
+    if (value.id !== undefined && value.id !== d) throw new ServiceError("internal", "Document metadata ownership mismatch")
+    return c
+  }
+  return {
+    async read(p, d) { const r = await record(p, d); return r ? { revision: r.revision, checkpoint: checkpoint(r.data, p, d) } : null },
+    async save(p, d, expectedRevision, input) {
+      const c = validateCheckpoint(input)
+      if (c.projectId !== p || c.documentId !== d) throw new ServiceError("invalid_argument", "Checkpoint ownership mismatch")
+      const r = await record(p, d)
+      if (!r) throw new ServiceError("not_found", "Document not found")
+      const previous = checkpoint(r.data, p, d)
+      if (r.revision !== expectedRevision) throw new ServiceError("conflict", "Document changed; reload before merging")
+      if (Date.parse(c.updatedAt) < Date.parse(previous.updatedAt) || c.createdAt !== previous.createdAt || c.policy.index !== previous.policy.index || c.policy.feedback !== previous.policy.feedback) throw new ServiceError("invalid_argument", "Checkpoint history mismatch")
+      if (c.stages.receive.evidence.length !== previous.stages.receive.evidence.length || c.stages.receive.evidence.some((ref, i) => ref !== previous.stages.receive.evidence[i])) throw new ServiceError("invalid_argument", "Received artifact evidence is immutable")
+      const saved = await shared.save(p, "document", d, { ...r.data as Record<string, unknown>, ingestionCheckpoint: c }, expectedRevision, c.updatedAt)
+      return { revision: saved.revision, checkpoint: checkpoint(saved.data, p, d) }
+    },
+  }
+}
